{
  "name": "@chaoran-property-intelligence/aws-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "aws-cdk-lib": "2.266.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "aws-cdk": "2.1138.0"
  },
  "scripts": {
    "application-secret": "pnpm build && node --env-file=../../.env.local dist/bin/syncApplicationSecret.js",
    "build": "tsc -p tsconfig.build.json",
    "synth": "pnpm build && cdk synth --app 'node dist/bin/app.js'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
